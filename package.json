{
  "name": "next-auth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "docker:build": "docker build -t next-auth-app .",
    "docker:run": "docker run -p 3000:3000 --env-file .env.local next-auth-app",
    "docker:compose:up": "docker-compose up --build",
    "docker:compose:down": "docker-compose down",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1",
    "validate-env": "node -e \"require('./src/lib/config')\"",
    "prestart": "npm run validate-env"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.6.1",
    "next": "14.1.0",
    "next-auth": "^4.24.11",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
